# ── Flask ─────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=any-random-string-you-make-up-here

# ── Database (local Postgres) ─────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitvision_dev

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=another-random-string-different-from-above

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Cloudinary (image storage — replaces AWS S3) ──────────
CLOUDINARY_CLOUD_NAME=your-cloud-name-here
CLOUDINARY_API_KEY=your-api-key-here
CLOUDINARY_API_SECRET=your-api-secret-here

# ── Hugging Face (AI try-on — replaces Fashn.ai) ──────────
HUGGINGFACE_API_TOKEN=hf_your_token_here
# Optional overrides (defaults target the CatVTON Space):
# HF_TRYON_SPACE=zhengchong/CatVTON
# HF_TRYON_API_NAME=/submit_function

# ── Product catalog API (DummyJSON — no key needed) ───────
PRODUCT_API_BASE_URL=https://dummyjson.com
