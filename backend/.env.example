# ── Flask ─────────────────────────────────────────────────
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# ── Database ──────────────────────────────────────────────
# Render provides this automatically for managed Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fitvision_dev

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-in-production

# ── CORS ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── AWS S3 ────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_PRESIGNED_URL_EXPIRY=900

# ── RapidAPI ──────────────────────────────────────────────
RAPIDAPI_KEY=your-rapidapi-key
RAPIDAPI_HOST=apidojo-h-and-m-hm-v1.p.rapidapi.com

# ── Fashn.ai ──────────────────────────────────────────────
FASHN_API_KEY=your-fashn-api-key
FASHN_API_BASE_URL=https://api.fashn.ai/v1
